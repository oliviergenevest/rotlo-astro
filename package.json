{
  "name": "astro-starter-ogweb",
  "type": "module",
  "version": "1.0.1",
  "scripts": {
    "prepare": "npx simple-git-hooks && npm run generate-schema && npm run generate-cma-types",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-schema": "dotenv -- gql.tada generate schema https://graphql.datocms.com --header \"X-Exclude-Invalid: true\" --header \"Authorization: Bearer $DATOCMS_PUBLISHED_CONTENT_CDA_TOKEN\"",
    "generate-cma-types": "dotenv -- npx @datocms/cli schema:generate --api-token=$DATOCMS_CMA_TOKEN src/lib/datocms/cma-types.ts",
    "lint": "prettier --check .",
    "format": "npx prettier . --write"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/node": "^10.0.4",
    "@astrojs/react": "^5.0.4",
    "@datocms/astro": "^0.6.11",
    "@datocms/cda-client": "^0.2.10",
    "@datocms/cma-client": "^5.4.14",
    "@iconify-json/teenyicons": "^1.2.2",
    "@mux/mux-player": "^3.13.0",
    "@mux/mux-player-react": "^3.13.0",
    "@netlify/functions": "^5.2.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.2.0",
    "astro-embed": "^0.13.0",
    "astro-font": "^1.1.0",
    "astro-swiper": "^2.6.0",
    "date-fns": "^4.1.0",
    "datocms-structured-text-generic-html-renderer": "^5.1.7",
    "datocms-structured-text-to-plain-text": "^5.1.7",
    "free-astro-components": "^1.2.0",
    "gql.tada": "^1.9.0",
    "hiding-header": "^0.9.1",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^3.3.2",
    "react": "^19.2.3",
    "react-datocms": "^8.0.2",
    "react-dom": "^19.2.3",
    "react-swift-reveal": "^1.3.0",
    "rfs": "^10.0.0",
    "serialize-error": "^12.0.0",
    "sitemap": "^8.0.0",
    "typescript": "^5.9.3",
    "vite-plugin-bundlesize": "^0.2.0"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.7",
    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^9.0.6",
    "astro-icon": "^1.1.5",
    "dotenv-cli": "^11.0.0",
    "postcss-nested": "^7.0.2",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "simple-git-hooks": "^2.13.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run format"
  },
  "overrides": {
    "vite": "^7"
  }
}
