---
import { graphql } from '~/lib/datocms/graphql';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { isDraftModeEnabled } from '~/lib/draftMode';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { Wrapper } from '~/components/Wrapper';
import { Icon } from 'astro-icon/components';

const query = graphql(/* GraphQL */ `
  query NavigationQuery {
    allNavigations(orderBy: position_ASC) {
      items {
        title
        backgroundColor {
          hex
        }
        slug
        position
      }
    }
  }
`);

const draftModeEnabled = isDraftModeEnabled(Astro.cookies);
const { allNavigations } = await executeQuery(query, { includeDrafts: draftModeEnabled });

if (!allNavigations) {
  return new Response(null, {
    status: 404,
    statusText: 'Not found',
  });
}

// the `pathname` is sth like - "/agenda"
const { pathname } = Astro.url;
const pathSlug = pathname.replace(/\/$/, '').slice(1);
---

<nav class="mobile_nav">
  <ul>
    <li>
      <a
        href="/"
        title="Accueil"
        class:list={'link--metis'}
        aria-current={pathSlug === '' ? 'page' : 'false'}
      >
        Accueil
      </a>
    </li>
    {
      allNavigations.map((item) => (
        <li>
          <a
            href={'/' + item.items.slug}
            title={item.items.title}
            class:list={'link--metis'}
            aria-current={pathSlug === item.items.slug ? 'page' : 'false'}
          >
            {item.items.title}
          </a>
        </li>
      ))
    }
  </ul>
  <a href="festival-champ-des-ondes-2026#billetterie" class="button_cta">
      <Icon class="icon" name="ticket" title="Billetterie en ligne" /> BILLETTERIE
    </a>
</nav>
<div class="overlay"></div>
<style>
  nav {
    display: none;
  }
  ul {
    display: flex;
    gap: rfs(8px);
    justify-content: center;
    list-style: none;
    flex-wrap: wrap;
  }
  li {
    padding: rfs(16px);
  }
  li a, li a:hover {
    font-family: var(--font-headline);
    font-size: 22px;
   
    text-decoration: none;
    position: relative;
    padding-bottom: 4px;
  }

 li a[aria-current='page']::before {
    /* the styles for the active nav item */
    transform-origin: 0% 50%;
    transform: scale3d(1, 1, 1);
  }


  .link--metis::before {
    content: '';
    position: absolute;
    width: 100%;
    height: 2px;
    background: var(--color-yellow);
    top: 100%;
    left: 0;
    pointer-events: none;
    transform-origin: 100% 50%;
    transform: scale3d(0, 1, 1);
    transition: transform 0.3s;
  }

  .link--metis:hover::before {
    transform-origin: 0% 50%;
    transform: scale3d(1, 1, 1);
  }

  nav.mobile_nav {
    /* nav responsive ci dessous pour mobile */

    display: block;
    position: fixed;
    z-index: 12;
    top: 0;
    bottom: 0;
    right: 0;
    width: 0;
    overflow: hidden;
    height: 100vh;
    background-color: #0f475f;

    transition: all 0.15s ease-in;
    ul {
      display: flex;
      flex-direction: column;
      padding-top: 78px;
      a,
      a:hover {
        color: var(--color-white);
      }
    }

    .button_cta {
          margin-left: 5rem;
    margin-top: 2rem;
    }

    .btn_close {
      display: none;
    }

    &.expanded {
      width: 350px;
      height: 100vh;

      transition: width 0.2s ease-in-out;
    }
  }

  html .overlay {
    position: fixed;
  }

  html.menu_open .overlay {
    display: none;
    position: fixed;
    background-color: rgba(17, 17, 17, 0.516);
    width: 100%;
    height: 100vh;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 11;

    display: block;
  }
</style>
<style is:global>
  html.menu_open {
    padding-right: 12px;
  }
  body.menu_open {
    overflow: hidden !important;
  }
</style>
