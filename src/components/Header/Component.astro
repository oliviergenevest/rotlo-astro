---
import { NavigationMobile } from '~/components/NavigationMobile';
import { Navigation } from '~/components/Navigation';
import Hamburger from '../Hamburger.astro';
import { Icon } from 'astro-icon/components';
import { Fade } from 'react-swift-reveal';
import { Slide } from 'react-swift-reveal';

type Props = {
  class?: String;
};
//console.log('Astro.props',Astro.props)
const customClass = Astro.props.class;
---

<div
  class="hidingHeader"
  id={customClass ? 'hidingHeader' : 'hidingHeader'}
  transition:name="main-nav"
>
  <div class:list={['header hidingHeader-in', customClass]} class="header hidingHeader-in">
    <a href="/" title="Page d'accueil">
      {
        customClass ? (
          <Icon class="brandlogo" name={'brand-logo'} title="Rock on the l'Oule" />
        ) : (
          <Icon class="brandlogo" name={'brand-logo'} title="Rock on the l'Oule" />
        )
      }
    </a>
    <NavigationMobile />
    <!--  <Slide client:only="react" duration={1000} delay={80} top distance="16px">
      <Fade client:only="react" duration={800} delay={0}>
        
      </Fade>
    </Slide> -->
    <Navigation />
    <a href="festival-champ-des-ondes-2026#billetterie" class="button_cta">
      <Icon class="icon" name="ticket" title="Billetterie en ligne" /> BILLETTERIE
    </a>
    <Hamburger />
  </div>
</div>

<style>
  [data-icon='brand-logo'] {
    font-size: rfs(4.48rem);

    max-width: 100%;
  }
  [data-icon='ticket'] {
    font-size: rfs(5.48rem);
    max-width: 100%;
  }

  .header {
    box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
    background-color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 16px;
    @media (max-width: 500px) {
      padding: 16px 16px;
    }

    &.transparent {
      background-color: white;
    }
  }
  .header .button_cta {
    padding-top: 0;
    padding-bottom: 0;
  }
  @media screen and (max-width: 500px) {
    .header .button_cta {
      display: none;
    }
  }
</style>

<script>
  import { hidingHeader } from 'hiding-header';

  document.addEventListener('astro:page-load', () => {
    const container = document.querySelector('#hidingHeader') as HTMLElement;
    hidingHeader(container);

    document.querySelector('.overlay')?.addEventListener('click', (e) => {
      e.preventDefault();
      document.querySelector('.menu-icon')?.classList.toggle('is-opened');
      document.querySelector('nav.mobile_nav')?.classList.toggle('expanded');
      document.querySelector('html')?.classList.toggle('menu_open');
      document.querySelector('body')?.classList.toggle('menu_open');
    });
  });
</script>
