---
import type { HTMLTag, Polymorphic } from 'astro/types';

type Props<T extends HTMLTag = 'div'> = Polymorphic<{
  as: T;
  bgcolor?: string;
}>;

const { as: Tag = 'div' as any, bgcolor, ...props } = Astro.props;

const bgBlockColor = bgcolor;
//console.log('bgBlockColor', bgBlockColor);
console.log('wrapper component props', props);
---

<Tag {...props} class="wrapper" style={`--color: ${bgBlockColor}`} {...props}>
  <slot />
</Tag>

<style>
  .wrapper {
    width: 100%;
    padding-left: var(--page-margin);
    padding-right: var(--page-margin);
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--color);
  }

  .wrapper.wide {
    max-width: 1280px;
  }

  .wrapper.homepage {
    display: flex;
    flex-direction: column;
    /* gap: rfs(32px);*/
  }
</style>
