---
import { type FragmentOf, readFragment } from '~/lib/datocms/graphql';
import {IframeBilletterieFragment } from './fragments';

interface Props {
  block: FragmentOf<typeof IframeBilletterieFragment>;
}

const { block } = Astro.props;

// Read unmasked block from fragment
const unmaskedBlock = readFragment(IframeBilletterieFragment, block);
//console.log(unmaskedBlock.video.url);
---

{/* Render the iframe billetterie from helloasso */}
<iframe id="haWidget" allowtransparency="true" scrolling="auto" src="https://www.helloasso.com/associations/association-rock-on-the-l-oule/evenements/festival-le-champ-des-ondes-2026/widget" style="width: 100%; height: 850px; border: none;" onload="window.addEventListener('message', function(e) { const dataHeight = e.data.height; const haWidgetElement = document.getElementById('haWidget'); 
  if (dataHeight > parseFloat(haWidgetElement.height || 0)) { haWidgetElement.height = dataHeight + 'px';}})"></iframe>
