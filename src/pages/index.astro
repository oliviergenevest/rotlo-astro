---
import { graphql } from '~/lib/datocms/graphql';
import { Layout } from '../layouts/Layout';
import { TagFragment } from '~/lib/datocms/commonFragments';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { getImage } from 'astro:assets';

import { isDraftModeEnabled } from '~/lib/draftMode';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';

import { SectionBlock } from '~/components/blocks/SectionBlock';
import { SectionBlockFragment } from '~/components/blocks/SectionBlock/fragments';

import { Wrapper } from '~/components/Wrapper';
import { Title } from '~/components/Title';
import { fade, slide } from 'astro:transitions';

/**
 * The GraphQL query that will be executed for this route to generate the homepage
 * content and metadata.
 *
 * Thanks to gql.tada, the result will be fully typed!
 */
const query = graphql(
  /* GraphQL */ `
    query HomepageQuery {
      homepage {
        _seoMetaTags {
          ...TagFragment
        }
        title
        id
        ctaText
        backgroundImage {
          url
        }
        backgroundColor {
          hex
        }
        _firstPublishedAt
        sections {
          ...SectionBlockFragment
        }
      }
    }
  `,
  [TagFragment, SectionBlockFragment],
);

const draftModeEnabled = isDraftModeEnabled(Astro.cookies);
const { homepage } = await executeQuery(query, { includeDrafts: draftModeEnabled });

if (!homepage) {
  return new Response(null, {
    status: 404,
    statusText: 'Not found',
  });
}

const optimizedBgImage = await getImage({ src: homepage.backgroundImage.url, inferSize: true });
//console.log( "optimizedBgImage",optimizedBgImage.src);
---

<Layout additionalSeo={homepage._seoMetaTags}>
  <div class="section_cta" style={`--urlimg: url('${optimizedBgImage.src}');`}>
    <Wrapper> <div class="content fade-in-bottom" set:html={homepage.ctaText} /></Wrapper>
  </div>
  <Wrapper class="wrapper homepage" bgcolor={homepage.backgroundColor?.hex}>
    {
      homepage.sections.map((item) => (
        <SectionBlock
          transition:animate={slide({ duration: '0.4s' })}
          block={item}
          transition:animate={slide({ duration: '2.4s' })}
        />
      ))
    }
  </Wrapper>

  <!--<div>Published at {homepage._firstPublishedAt}</div> -->

  <DraftModeQueryListener query={query} />
</Layout>

<style>
  .section_cta {
    min-height: 500px;
    min-height: calc(100vh - 115px);
    display: flex;
    align-items: center;
    background-image: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.15)), var(--urlimg);
    background-size: cover;
    background-repeat: no-repeat;
    background-position: left center;
    /* margin-bottom: 30px;*/
  }

  .content {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: center;
    align-items: center;

    :global(h1) {
      color: var(--color-white);
      font-family: var(--font-headline);
      text-transform: none;
      font-weight: 900;
      font-size: clamp(18px, 3vw, 24px);
    }
    :global(h2) {
      max-width: 1024px;
      color: var(--color-yellow);
      font-family: var(--font-headline);
      text-transform: uppercase;
      font-weight: 900;
      font-size: clamp(24px, 4vw, 48px);
      text-shadow: 1px 2px 2px #000000;
      hyphens: none;
    }
    :global(h2 span) {
      color: white;
    }
    :global(p) {
      color: white;
    }
  }
  .homepage :global(.subtitle p) {
    color: var(--color-yellow);
  }
  .homepage :global(.card_title) {
    color: var(--color-white);
  }
</style>
